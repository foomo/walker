{
  "name": "htmlschema",
  "displayName": "htmlschema",
  "description": "Completion, hover and lint diagnostics for foomo walker htmlschema files",
  "version": "0.1.0",
  "publisher": "foomo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/foomo/walker",
    "directory": "editors/vscode-htmlschema"
  },
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": ["Programming Languages", "Linters"],
  "activationEvents": ["onLanguage:html"],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "htmlschema.restartServer",
        "title": "htmlschema: Restart Language Server"
      }
    ],
    "configuration": {
      "title": "htmlschema",
      "properties": {
        "htmlschema.serverPath": {
          "type": "string",
          "default": "htmlschema-lsp",
          "markdownDescription": "Path of the `htmlschema-lsp` binary. A bare name is looked up on the `PATH`, then in `$GOBIN`, `$GOPATH/bin` and `~/go/bin`."
        },
        "htmlschema.trace.server": {
          "type": "string",
          "enum": ["off", "messages", "verbose"],
          "default": "off",
          "description": "Traces the communication between VS Code and the language server."
        }
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
